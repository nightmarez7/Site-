# Anthropic (geração de roteiro)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Runway ML (geração de imagem/vídeo por cena)
RUNWAY_API_KEY=
# RUNWAY_BASE_URL=https://api.dev.runwayml.com/v1
# RUNWAY_API_VERSION=2024-11-06
# MIDIA_TIPO=imagem   # "imagem" (padrão, rápido/barato) ou "video" (anima cada cena)

# ElevenLabs (narração/diálogo por cena)
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Montagem final
# FONTE_LEGENDA_PATH=/caminho/para/uma/fonte.ttf   # opcional; senão usa uma fonte do sistema
# TAMANHO_FONTE_LEGENDA=72
# MUSICA_FUNDO_VOLUME=0.15   # coloque mp3/wav livres de direitos em media/musica/
# VIDEO_FPS=30

# TikTok Content Posting API (requer app aprovado no TikTok for Developers)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
# TIKTOK_PRIVACY_LEVEL=SELF_ONLY   # troque para PUBLIC_TO_EVERYONE só quando quiser publicar de fato
# Sem TIKTOK_ACCESS_TOKEN (ou se a publicação falhar), o vídeo fica pronto em
# PASTA_POSTAGEM_MANUAL (padrão: media/final/) para você postar manualmente.
# PASTA_POSTAGEM_MANUAL=
