# Python
__pycache__/
*.pyc
.venv/
venv/

# Segredos
.env

# Mídia gerada (pesada, não versionar)
media/raw/*
media/final/*
media/musica/*
!media/raw/.gitkeep
!media/final/.gitkeep
!media/musica/.gitkeep

# Vídeos de teste soltos na raiz (não fazem parte do código)
/teste_pipeline_*.mp4

# Dados locais / logs
data/*.db
data/logs/*.log
data/roteiros/*.json
!data/roteiros/.gitkeep
